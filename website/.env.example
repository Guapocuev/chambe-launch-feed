# ============================================================
# Chambé Website — Environment Variables
# Copy to .env.local for local dev, or set via docker-compose.
# ============================================================

# Base URL of the Demand Engine (Chambe-mvp/demand-engine). Only ever
# read server-side (Server Actions), never sent to the browser.
#   - Local dev (demand-engine running on your host): http://localhost:3000
#   - docker-compose (this site running alongside the engines):
#     http://demand-engine:3000
DEMAND_ENGINE_URL=http://localhost:3000

# Must match the Demand Engine's FORM_API_KEY exactly (see
# Chambe-mvp/demand-engine/.env.example) — POST /webhooks/tally-intake
# and POST /contractors/apply both reject every request without a
# matching X-Api-Key header. Unlike DEMAND_ENGINE_URL above, there's no
# safe default here: leave it unset and both forms fail outright.
DEMAND_ENGINE_API_KEY=

# Photo uploads on /get-a-quote go through Demand Engine
# POST /media/sign-upload (see Chambe-mvp/demand-engine/.env.example
# SUPABASE_URL + SUPABASE_SERVICE_KEY). No Supabase key is needed here.

# Speech-to-text on the quote form (mic → job description). Server-only.
# Same env name as Chambe-mvp/quote-engine — reuse that key if you already
# have one; the website does not read the quote-engine .env.
# Leave unset and the mic still shows; transcription returns a config error.
OPENAI_API_KEY=

# Optional. Default whisper-1 (~$0.006/min). gpt-4o-mini-transcribe is ~$0.003/min.
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Public site URL — used for sitemap, canonical URLs, and Open Graph.
#   - Production: https://chambe.ca
#   - Local Netlify/Next: http://localhost:3001
NEXT_PUBLIC_SITE_URL=https://chambe.ca

# Optional — enables click-to-call in nav, mobile sticky bar, and contact page.
# Format: (647) 555-0100
# NEXT_PUBLIC_CONTACT_PHONE=

# Optional — analytics (enable one or both).
# Google Analytics 4 measurement ID — e.g. G-XXXXXXXXXX
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Plausible domain — e.g. chambe.ca
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Contractor + apprentice login (Supabase Auth). Anon key only — never the service role.
# Email magic link works today. Phone OTP (SMS) needs a phone provider in
# Supabase Auth (Twilio, etc.) — follow-up, not blocking.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional. Chat model for apprentice jobsite Q&A (default gpt-4o-mini).
# OPENAI_CHAT_MODEL=gpt-4o-mini
