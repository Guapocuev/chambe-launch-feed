# ============================================================
# Chambé Website — Environment Variables
# Copy to .env.local for local dev, or set via docker-compose.
# ============================================================

# Base URL of the Demand Engine (Chambe-mvp/demand-engine). Only ever
# read server-side (Server Actions), never sent to the browser.
#   - Local dev (demand-engine running on your host): http://localhost:3000
#   - docker-compose (this site running alongside the engines):
#     http://demand-engine:3000
DEMAND_ENGINE_URL=http://localhost:3000

# Public site URL — used for sitemap, canonical URLs, and Open Graph.
#   - Production: https://chambe.ca
#   - Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://chambe.ca

# Optional — enables click-to-call in nav, mobile sticky bar, and contact page.
# Format: (647) 555-0100
# NEXT_PUBLIC_CONTACT_PHONE=

# Optional — analytics (enable one or both).
# Google Analytics 4 measurement ID — e.g. G-XXXXXXXXXX
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Plausible domain — e.g. chambe.ca
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
