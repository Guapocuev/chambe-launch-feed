# ============================================================
# Chambé Website — Environment Variables
# Copy to .env.local for local dev, or set via docker-compose.
# ============================================================

# Base URL of the Demand Engine (Chambe-mvp/demand-engine). Only ever
# read server-side (Server Actions), never sent to the browser.
#   - Local dev (demand-engine running on your host): http://localhost:3000
#   - docker-compose (this site running alongside the engines):
#     http://demand-engine:3000
DEMAND_ENGINE_URL=http://localhost:3000
